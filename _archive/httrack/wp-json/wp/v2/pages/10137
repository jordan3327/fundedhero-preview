{"id":10137,"date":"2025-09-30T08:03:24","date_gmt":"2025-09-30T08:03:24","guid":{"rendered":"https:\/\/fundedherofutures.com\/?page_id=10137"},"modified":"2026-09-05T23:27:37","modified_gmt":"2026-09-05T23:27:37","slug":"home","status":"publish","type":"page","link":"https:\/\/fundedherofutures.com\/","title":{"rendered":"Home"},"content":{"rendered":"\n<div class=\"gb-element-877e1104 golden-particles-bg\">\n<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\" \/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" \/>\n  <title>Part\u00edculas #edc940<\/title>\n  <style>\n    .golden-particles-bg {\n      position: relative;\n      overflow: hidden;\n    }\n    .golden-particles-bg canvas {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      pointer-events: none;\n      display: block;\n    }\n  <\/style>\n<\/head>\n<body>\n\n  <!-- Ejemplo: cualquier contenedor con esta clase -->\n  <section class=\"golden-particles-bg\"><\/section>\n\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      const containers = document.querySelectorAll('.golden-particles-bg');\n      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      const isSmallScreen = window.matchMedia('(max-width: 640px)').matches;\n\n      containers.forEach(setupParticlesForContainer);\n\n      function setupParticlesForContainer(container) {\n        const canvas = document.createElement('canvas');\n        container.appendChild(canvas);\n        const ctx = canvas.getContext('2d', { alpha: true });\n\n        \/\/ DPR: nitidez con tope para m\u00f3viles\n        const rawDpr = window.devicePixelRatio || 1;\n        const maxDpr = isSmallScreen ? 1.5 : 2;\n        const dpr = Math.min(rawDpr, maxDpr);\n\n        let particles = [];\n        let rafId = null;\n        let running = false;\n        let lastTime = 0;\n\n        \/\/ Conexiones\n        const MAX_LINK_DIST = 110;       \/\/ menor en m\u00f3vil\n        const GRID_SIZE = MAX_LINK_DIST; \/\/ celda = rango de enlace\n\n        \/\/ Densidad adaptativa\n        function computeParticleCount() {\n          const area = container.clientWidth * container.clientHeight;\n          \/\/ densidad base (ajustada para m\u00f3viles)\n          const density = prefersReducedMotion ? 0.00004 : (isSmallScreen ? 0.00008 : 0.00012);\n          const count = Math.round(area * density);\n          \/\/ l\u00edmites razonables\n          const minC = prefersReducedMotion ? 12 : (isSmallScreen ? 24 : 36);\n          const maxC = prefersReducedMotion ? 50 : (isSmallScreen ? 90 : 160);\n          return Math.max(minC, Math.min(maxC, count));\n        }\n\n        function resizeCanvas() {\n          const w = container.clientWidth || 0;\n          const h = container.clientHeight || 0;\n          canvas.width = Math.max(1, Math.floor(w * dpr));\n          canvas.height = Math.max(1, Math.floor(h * dpr));\n          \/\/ Escala para coordenadas l\u00f3gicas (CSS px)\n          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n        }\n\n        class Particle {\n          constructor(width, height) {\n            this.w = width;\n            this.h = height;\n            this.reset(true);\n          }\n          reset(randomY = false) {\n            this.x = Math.random() * (this.w || container.clientWidth);\n            this.y = randomY ? Math.random() * (this.h || container.clientHeight) : -10;\n            this.size = Math.random() * (isSmallScreen ? 2.2 : 3) + 0.8;\n            this.speedX = (Math.random() * 0.5 - 0.25) * (isSmallScreen ? 0.8 : 1);\n            this.speedY = (Math.random() * 1 + 0.5) * (isSmallScreen ? 0.85 : 1);\n            this.opacity = Math.random() * 0.5 + 0.3;\n          }\n          update(dt, width, height) {\n            \/\/ dt en segundos; suaviza en m\u00f3viles con throttling natural\n            const dx = this.speedX * dt * 60;\n            const dy = this.speedY * dt * 60;\n            this.x += dx;\n            this.y += dy;\n\n            if (this.y > height + 12) this.reset(false);\n            if (this.x < -12 || this.x > width + 12) {\n              this.x = Math.random() * width;\n            }\n          }\n          draw(ctx) {\n            ctx.globalAlpha = this.opacity;\n            ctx.beginPath();\n            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);\n            ctx.fill();\n          }\n        }\n\n        function initParticles() {\n          const count = computeParticleCount();\n          particles = new Array(count);\n          for (let i = 0; i < count; i++) {\n            particles[i] = new Particle(canvas.width \/ dpr, canvas.height \/ dpr);\n          }\n        }\n\n        \/\/ Espacial hashing (rejilla) para links eficientes\n        function buildGrid(width, height) {\n          const cols = Math.max(1, Math.ceil(width \/ GRID_SIZE));\n          const rows = Math.max(1, Math.ceil(height \/ GRID_SIZE));\n          const grid = new Map(); \/\/ key: \"c,r\" -> array \u00edndices\n\n          for (let i = 0; i < particles.length; i++) {\n            const p = particles[i];\n            const c = Math.floor(p.x \/ GRID_SIZE);\n            const r = Math.floor(p.y \/ GRID_SIZE);\n            const key = `${c},${r}`;\n            if (!grid.has(key)) grid.set(key, []);\n            grid.get(key).push(i);\n          }\n          return { grid, cols, rows };\n        }\n\n        function forNearby(i, width, height, cb) {\n          const p = particles[i];\n          const c = Math.floor(p.x \/ GRID_SIZE);\n          const r = Math.floor(p.y \/ GRID_SIZE);\n          \/\/ vecinos (3x3)\n          for (let dc = -1; dc <= 1; dc++) {\n            for (let dr = -1; dr <= 1; dr++) {\n              cb(c + dc, r + dr);\n            }\n          }\n        }\n\n        \/\/ Observers &#038; handlers\n        const ro = new ResizeObserver(debounce(() => {\n          resizeCanvas();\n          initParticles();\n        }, 150));\n        ro.observe(container);\n\n        const io = new IntersectionObserver((entries) => {\n          for (const entry of entries) {\n            if (entry.target === container) {\n              if (entry.isIntersecting) start();\n              else stop();\n            }\n          }\n        }, { root: null, threshold: 0 });\n\n        io.observe(container);\n\n        document.addEventListener('visibilitychange', () => {\n          if (document.hidden) stop();\n          else start();\n        });\n\n        function start() {\n          if (running) return;\n          running = true;\n          lastTime = performance.now();\n          rafId = requestAnimationFrame(tick);\n        }\n\n        function stop() {\n          running = false;\n          if (rafId) cancelAnimationFrame(rafId);\n          rafId = null;\n        }\n\n        function tick(now) {\n          if (!running) return;\n          const dt = Math.min(0.05, (now - lastTime) \/ 1000); \/\/ cap 50ms\n          lastTime = now;\n\n          const width = canvas.width \/ dpr;\n          const height = canvas.height \/ dpr;\n\n          \/\/ Clear\n          ctx.clearRect(0, 0, width, height);\n\n          \/\/ Set state once por frame\n          ctx.fillStyle = '#edc940';\n          ctx.shadowColor = '#edc940';\n          ctx.shadowBlur = 8;\n\n          \/\/ Particles\n          for (let i = 0; i < particles.length; i++) {\n            const p = particles[i];\n            p.update(dt, width, height);\n            p.draw(ctx);\n          }\n\n          \/\/ Lines (omit if reduced motion)\n          if (!prefersReducedMotion) {\n            ctx.shadowBlur = 0; \/\/ evitar blur en l\u00edneas\n            ctx.lineWidth = 0.6;\n            const { grid } = buildGrid(width, height);\n\n            \/\/ iterar celdas y vecinas\n            const visited = new Set();\n            for (const [key, arr] of grid) {\n              const [cStr, rStr] = key.split(',');\n              const c = parseInt(cStr, 10);\n              const r = parseInt(rStr, 10);\n\n              \/\/ Candidatos: celda actual + vecinas\n              const neighborLists = [];\n              for (let dc = 0; dc <= 1; dc++) {\n                for (let dr = -1; dr <= 1; dr++) {\n                  const nk = `${c + dc},${r + dr}`;\n                  if (grid.has(nk)) neighborLists.push(grid.get(nk));\n                }\n              }\n\n              for (const i of arr) {\n                const pi = particles[i];\n                for (const list of neighborLists) {\n                  for (const j of list) {\n                    if (j <= i) continue; \/\/ evitar duplicados\n                    const pj = particles[j];\n                    const dx = pi.x - pj.x;\n                    const dy = pi.y - pj.y;\n                    const dist = Math.hypot(dx, dy);\n                    if (dist < MAX_LINK_DIST) {\n                      const alpha = 0.15 * (1 - dist \/ MAX_LINK_DIST);\n                      ctx.strokeStyle = `rgba(237,201,64,${alpha.toFixed(3)})`;\n                      ctx.beginPath();\n                      ctx.moveTo(pi.x, pi.y);\n                      ctx.lineTo(pj.x, pj.y);\n                      ctx.stroke();\n                    }\n                  }\n                }\n              }\n              visited.add(key);\n            }\n          }\n\n          rafId = requestAnimationFrame(tick);\n        }\n\n        \/\/ Utils\n        function debounce(fn, wait) {\n          let t;\n          return (...args) => {\n            clearTimeout(t);\n            t = setTimeout(() => fn.apply(this, args), wait);\n          };\n        }\n\n        \/\/ Inicializaci\u00f3n\n        resizeCanvas();\n        initParticles();\n        start();\n\n        \/\/ Limpieza si hiciera falta (por SPA\/unmount)\n        container._destroyParticles = () => {\n          stop();\n          ro.disconnect();\n          io.disconnect();\n          canvas.remove();\n        };\n      }\n    });\n  <\/script>\n<\/body>\n<\/html>\n\n\n\n<div class=\"gb-element-d2b7680a\">\n<div class=\"gb-element-0f91bd9b\">\n<div class=\"gb-element-5979c159\">\n<div class=\"gb-element-b52718d8\">\n<h1 class=\"gb-text gb-text-14ef9c42\">Think You Can Beat the Market? Prove It in&nbsp;<\/h1>\n\n\n\n<h1 class=\"gb-text gb-text-acf43434\"><strong><mark style=\"background-color:rgba(0, 0, 0, 0);color:#ffc500\" class=\"has-inline-color\">FundedHero<\/mark><\/strong> Futures<\/h1>\n\n\n\n<div class=\"gb-element-182421b0\">\n<span class=\"gb-button gb-button-9f80bd18 gb-button-text cta-button smooth-scroll\">Get Funded<\/span>\n\n\n\n<a class=\"gb-button gb-button-8f7a7fff cta-button smooth-scroll\" href=\"https:\/\/discord.gg\/nxAVgCbJP6\" target=\"_blank\" rel=\"noopener noreferrer\"><span class=\"gb-button-text\">Discord<\/span><span class=\"gb-icon\"><svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" height=\"800px\" width=\"800px\"> <path stroke-linejoin=\"round\" stroke=\"#000000\" d=\"M18.8943 4.34399C17.5183 3.71467 16.057 3.256 14.5317 3C14.3396 3.33067 14.1263 3.77866 13.977 4.13067C12.3546 3.89599 10.7439 3.89599 9.14391 4.13067C8.99457 3.77866 8.77056 3.33067 8.58922 3C7.05325 3.256 5.59191 3.71467 4.22552 4.34399C1.46286 8.41865 0.716188 12.3973 1.08952 16.3226C2.92418 17.6559 4.69486 18.4666 6.4346 19C6.86126 18.424 7.24527 17.8053 7.57594 17.1546C6.9466 16.92 6.34927 16.632 5.77327 16.2906C5.9226 16.184 6.07194 16.0667 6.21061 15.9493C9.68793 17.5387 13.4543 17.5387 16.889 15.9493C17.0383 16.0667 17.177 16.184 17.3263 16.2906C16.7503 16.632 16.153 16.92 15.5236 17.1546C15.8543 17.8053 16.2383 18.424 16.665 19C18.4036 18.4666 20.185 17.6559 22.01 16.3226C22.4687 11.7787 21.2836 7.83202 18.8943 4.34399ZM8.05593 13.9013C7.01058 13.9013 6.15725 12.952 6.15725 11.7893C6.15725 10.6267 6.98925 9.67731 8.05593 9.67731C9.11191 9.67731 9.97588 10.6267 9.95454 11.7893C9.95454 12.952 9.11191 13.9013 8.05593 13.9013ZM15